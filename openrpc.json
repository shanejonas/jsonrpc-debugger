{
  "openrpc": "1.3.2",
  "info": {
    "title": "jsonrpc-debugger control plane",
    "version": "0.8.0"
  },
  "servers": [
    {
      "name": "local",
      "url": "http://127.0.0.1:8081"
    }
  ],
  "methods": [
    {
      "name": "rpc.discover",
      "summary": "Describe this control plane",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.getState",
      "summary": "Read debugger and GUI state",
      "params": [
        { "name": "includeAnnotations", "required": false, "schema": { "type": "boolean", "default": true } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.getUpdates",
      "summary": "Read new exchanges and completed outstanding requests in one consistent snapshot",
      "description": "Omit sessionId for a full initial snapshot. Otherwise pass the previous state.session.id, nextIndex, and the indexes of requests still awaiting responses. Changed sessions or cursors beyond current history return reset=true and full history. Other updates contain completed pending exchanges followed by new exchanges, ordered by index. Apply replacements by index and append new entries. Pass the previous annotationRevision to omit unchanged annotations. When annotations is present, replace the local list to apply additions, edits, and deletions; when absent, preserve it. Reset responses always contain annotations. Omitting annotationRevision retains the full annotation list and state.annotations for older clients. Revision-aware responses omit state.annotations. State, annotations, and pending interception requests come from the same snapshot.",
      "params": [
        { "name": "sessionId", "required": false, "schema": { "type": "string" } },
        { "name": "nextIndex", "required": false, "schema": { "type": "integer", "minimum": 0 } },
        { "name": "pendingIndices", "required": false, "schema": { "type": "array", "items": { "type": "integer", "minimum": 0 } } },
        { "name": "annotationRevision", "required": false, "schema": { "type": "integer", "minimum": 0 } }
      ],
      "result": {
        "name": "result",
        "schema": {
          "type": "object",
          "required": ["state", "reset", "nextIndex", "exchanges", "annotationRevision", "pending"],
          "properties": {
            "state": { "type": "object" },
            "annotationRevision": { "type": "integer", "minimum": 0 },
            "reset": { "type": "boolean" },
            "nextIndex": { "type": "integer", "minimum": 0 },
            "exchanges": { "type": "array", "items": { "type": "object", "required": ["index", "transport"], "properties": { "index": { "type": "integer", "minimum": 0 }, "transport": { "type": "string" }, "request": { "type": "object" }, "response": { "type": "object" } } } },
            "annotations": { "type": "array", "items": { "$ref": "#/components/schemas/Annotation" } },
            "pending": { "type": "array", "items": { "type": "object" } }
          }
        }
      },
      "examples": [{ "name": "Initial snapshot", "params": [], "result": { "name": "result", "value": { "state": {}, "annotationRevision": 0, "reset": true, "nextIndex": 0, "exchanges": [], "annotations": [], "pending": [] } } }]
    },
    {
      "name": "debugger.waitForChange",
      "summary": "Wait until the debugger revision changes or the timeout expires",
      "params": [
        { "name": "afterRevision", "required": true, "schema": { "type": "integer", "minimum": 0 } },
        { "name": "timeoutMs", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 60000 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.getPanel",
      "summary": "Read numbered request or response panel lines",
      "params": [
        { "name": "panel", "required": true, "schema": { "type": "string", "enum": ["request", "response"] } },
        { "name": "exchangeIndex", "required": false, "schema": { "type": "integer", "minimum": 0 } },
        { "name": "tab", "required": false, "schema": { "type": "string", "enum": ["headers", "body"] } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.getHistory",
      "summary": "Read persistent JSON-RPC exchanges from the active or named session",
      "params": [
        { "name": "limit", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 1000 } },
        { "name": "sessionId", "required": false, "schema": { "type": "string", "minLength": 1 } },
        { "name": "before", "required": false, "schema": { "type": "integer", "minimum": 0 } }
      ],
      "result": { "name": "result", "schema": { "type": "array" } }
    },
    {
      "name": "debugger.find",
      "summary": "Search durable sessions, exchanges, and annotations for literal text",
      "description": "Searches all sessions unless sessionId is provided. Matching is case-insensitive and limit applies independently to each result group.",
      "params": [
        { "name": "query", "required": true, "schema": { "type": "string", "minLength": 1 } },
        { "name": "limit", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 1000 } },
        { "name": "sessionId", "required": false, "schema": { "type": "string", "minLength": 1 } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/FindResults" } }
    },
    {
      "name": "debugger.listSessions",
      "summary": "List persistent debugger sessions newest first",
      "params": [
        { "name": "limit", "required": false, "schema": { "type": "integer", "minimum": 0, "maximum": 1000 } }
      ],
      "result": { "name": "result", "schema": { "type": "array", "items": { "$ref": "#/components/schemas/SessionSummary" } } }
    },
    {
      "name": "debugger.createSession",
      "summary": "Create and select an empty debugger session",
      "params": [
        { "name": "name", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.selectSession",
      "summary": "Select a persistent session in the TUI",
      "params": [
        { "name": "sessionId", "required": true, "schema": { "type": "string", "minLength": 1 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.renameSession",
      "summary": "Rename a persistent debugger session",
      "params": [
        { "name": "sessionId", "required": true, "schema": { "type": "string", "minLength": 1 } },
        { "name": "name", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 80 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.exportSession",
      "summary": "Export portable debugger history",
      "params": [],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/Session" } }
    },
    {
      "name": "debugger.replaySession",
      "summary": "Append a session to visible history without forwarding requests",
      "params": [
        { "name": "session", "required": true, "schema": { "$ref": "#/components/schemas/Session" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.sendRequest",
      "summary": "Send a JSON-RPC request through an HTTP data plane and return its response",
      "params": [
        {
          "name": "request",
          "required": true,
          "schema": {
            "oneOf": [
              { "type": "object" },
              { "type": "array", "minItems": 1, "items": { "type": "object" } }
            ]
          }
        }
      ],
      "result": { "name": "result", "schema": {} }
    },
    {
      "name": "debugger.selectExchange",
      "summary": "Select a history row in the TUI",
      "params": [
        { "name": "index", "required": true, "schema": { "type": "integer", "minimum": 0 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.setFocus",
      "summary": "Focus a TUI panel",
      "params": [
        { "name": "panel", "required": true, "schema": { "type": "string", "enum": ["history", "request", "response", "status"] } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.setFullscreen",
      "summary": "Expand or restore the focused TUI panel",
      "description": "Expands the focused request list or details panel. The status header cannot be expanded; focusing it exits fullscreen.",
      "params": [
        { "name": "fullscreen", "required": true, "schema": { "type": "boolean" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.revealLines",
      "summary": "Select and reveal highlighted request or response lines",
      "params": [
        { "name": "panel", "required": true, "schema": { "type": "string", "enum": ["request", "response"] } },
        { "name": "startLine", "required": true, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "endLine", "required": false, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "sessionId", "required": false, "schema": { "type": "string", "minLength": 1 } },
        { "name": "exchangeIndex", "required": false, "schema": { "type": "integer", "minimum": 0 } },
        { "name": "tab", "required": false, "schema": { "type": "string", "enum": ["headers", "body"] } },
        { "name": "text", "required": false, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.clearLineSelection",
      "summary": "Clear the highlighted line reference",
      "params": [],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.annotateLines",
      "summary": "Persist an annotation without changing the visible TUI state",
      "params": [
        { "name": "panel", "required": true, "schema": { "type": "string", "enum": ["request", "response"] } },
        { "name": "startLine", "required": true, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "endLine", "required": false, "schema": { "type": "integer", "minimum": 1 } },
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } },
        { "name": "exchangeIndex", "required": false, "schema": { "type": "integer", "minimum": 0 } },
        { "name": "tab", "required": false, "schema": { "type": "string", "enum": ["headers", "body"] } },
        { "name": "author", "required": false, "schema": { "type": "string", "enum": ["agent", "user"], "default": "agent" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/AnnotationResult" } }
    },
    {
      "name": "debugger.getAnnotations",
      "summary": "Read all annotations in the active session, ordered by thread",
      "params": [],
      "result": { "name": "result", "schema": { "type": "array", "items": { "$ref": "#/components/schemas/Annotation" } } }
    },
    {
      "name": "debugger.replyAnnotation",
      "summary": "Persist a reply inheriting its parent annotation's source reference",
      "description": "Preserves the visible TUI state. Author defaults to agent. Requires normal mode and an existing parent in the active session.",
      "params": [
        { "name": "annotationId", "required": true, "schema": { "type": "string", "minLength": 1 } },
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } },
        { "name": "author", "required": false, "schema": { "type": "string", "enum": ["agent", "user"], "default": "agent" } }
      ],
      "result": { "name": "result", "schema": { "$ref": "#/components/schemas/AnnotationResult" } }
    },
    {
      "name": "debugger.updateAnnotation",
      "summary": "Edit an annotation's message while preserving its author, time, and thread",
      "params": [
        { "name": "annotationId", "required": true, "schema": { "type": "string", "minLength": 1 } },
        { "name": "message", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 160 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.removeAnnotation",
      "summary": "Delete one annotation by ID, reparenting its replies to its parent or the thread root",
      "params": [
        { "name": "annotationId", "required": true, "schema": { "type": "string", "minLength": 1 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.scrollPanel",
      "summary": "Scroll a TUI panel by a signed line count",
      "params": [
        { "name": "panel", "required": true, "schema": { "type": "string", "enum": ["history", "request", "response"] } },
        { "name": "lines", "required": true, "schema": { "type": "integer" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.setTarget",
      "summary": "Set the HTTP proxy target URL",
      "params": [
        { "name": "url", "required": true, "schema": { "type": "string", "minLength": 1 } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.setFilter",
      "summary": "Filter history by method name or request ID",
      "params": [
        { "name": "text", "required": true, "schema": { "type": "string" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.setPaused",
      "summary": "Enable or disable client-request interception",
      "params": [
        { "name": "paused", "required": true, "schema": { "type": "boolean" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    },
    {
      "name": "debugger.getPending",
      "summary": "Read intercepted requests",
      "params": [],
      "result": { "name": "result", "schema": { "type": "array" } }
    },
    {
      "name": "debugger.resolvePending",
      "summary": "Allow, block, or complete an intercepted request",
      "params": [
        { "name": "id", "required": true, "schema": { "type": "string" } },
        { "name": "action", "required": true, "schema": { "type": "string", "enum": ["allow", "block", "complete"] } },
        { "name": "request", "required": false, "schema": { "type": "object" } },
        { "name": "headers", "required": false, "schema": { "type": "object", "additionalProperties": { "type": "string" } } },
        { "name": "response", "required": false, "schema": { "type": "object" } }
      ],
      "result": { "name": "result", "schema": { "type": "object" } }
    }
  ],
  "components": {
    "schemas": {
      "Annotation": {
        "type": "object",
        "required": ["id", "parentId", "author", "createdAtMs", "exchangeIndex", "panel", "tab", "startLine", "endLine", "message", "text"],
        "properties": {
          "id": { "type": "string" },
          "parentId": { "type": ["string", "null"] },
          "author": { "type": "string", "enum": ["user", "agent", "unknown"] },
          "createdAtMs": { "type": "integer", "minimum": 0 },
          "exchangeIndex": { "type": "integer", "minimum": 0 },
          "panel": { "type": "string", "enum": ["request", "response"] },
          "tab": { "type": "string", "enum": ["headers", "body"] },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "message": { "type": "string" },
          "text": { "type": "string" }
        }
      },
      "AnnotationResult": {
        "type": "object", "required": ["annotation", "state"],
        "properties": { "annotation": { "$ref": "#/components/schemas/Annotation" }, "state": { "type": "object" } }
      },
      "SessionSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "target", "createdAtMs", "updatedAtMs", "exchangeCount"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "target": { "type": "string" },
          "createdAtMs": { "type": "integer", "minimum": 0 },
          "updatedAtMs": { "type": "integer", "minimum": 0 },
          "exchangeCount": { "type": "integer", "minimum": 0 }
        }
      },
      "FindResults": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessions", "exchanges", "annotations"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionSummary" }
          },
          "exchanges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session", "exchange", "references"],
              "properties": {
                "session": { "$ref": "#/components/schemas/SessionSummary" },
                "exchange": { "type": "object" },
                "references": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/LineReference" }
                }
              }
            }
          },
          "annotations": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session", "annotation", "reference"],
              "properties": {
                "session": { "$ref": "#/components/schemas/SessionSummary" },
                "annotation": { "type": "object" },
                "reference": { "$ref": "#/components/schemas/LineReference" }
              }
            }
          }
        }
      },
      "LineReference": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId", "exchangeIndex", "panel", "tab", "startLine", "endLine", "text"],
        "properties": {
          "sessionId": { "type": "string" },
          "exchangeIndex": { "type": "integer", "minimum": 0 },
          "panel": { "type": "string", "enum": ["request", "response"] },
          "tab": { "type": "string", "enum": ["headers", "body"] },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "text": { "type": "string" }
        }
      },
      "Session": {
        "type": "object",
        "additionalProperties": false,
        "required": ["schemaVersion", "exportedAtMs", "target", "exchanges"],
        "properties": {
          "schemaVersion": { "type": "integer", "enum": [1] },
          "exportedAtMs": { "type": "integer", "minimum": 0 },
          "target": { "type": "string" },
          "exchanges": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionExchange" }
          }
        }
      },
      "SessionExchange": {
        "type": "object",
        "additionalProperties": false,
        "required": ["transport"],
        "properties": {
          "transport": {
            "type": "string",
            "enum": [
              "http",
              "http-batch",
              "stdio-json-lines",
              "stdio-content-length",
              "websocket"
            ]
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body", "timestampMs"],
            "properties": {
              "body": { "type": "object" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "timestampMs": { "type": "integer", "minimum": 0 }
            }
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "required": ["body", "timestampMs"],
            "properties": {
              "body": { "type": "object" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "timestampMs": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "anyOf": [
          { "required": ["request"] },
          { "required": ["response"] }
        ]
      }
    }
  }
}
